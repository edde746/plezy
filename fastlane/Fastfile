default_platform(:android)

platform :android do
  desc "Upload the signed PlezyNG App Bundle to the selected Google Play track."
  lane :publish_play_store do
    upload_to_play_store(
      aab: ENV.fetch("PLAY_AAB_PATH"),
      package_name: "org.snapetech.plezyng",
      json_key_data: ENV.fetch("SUPPLY_JSON_KEY_DATA"),
      track: ENV.fetch("PLAY_TRACK", "internal"),
      release_status: ENV.fetch("PLAY_RELEASE_STATUS", "draft"),
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Upload the signed PlezyNG Fire TV APK to Amazon Appstore without submitting it for review."
  lane :publish_amazon_appstore do
    upload_to_amazon_appstore(
      package_name: "org.snapetech.plezyng",
      apk: ENV.fetch("AMAZON_APK_PATH"),
      client_id: ENV.fetch("AMAZON_CLIENT_ID"),
      client_secret: ENV.fetch("AMAZON_CLIENT_SECRET"),
      overwrite_upload: true,
      overwrite_upload_mode: "reuse",
      changes_not_sent_for_review: true
    )
  end
end

platform :ios do
  desc "Upload a signed iOS or tvOS PlezyNG IPA to App Store Connect without submitting it for review."
  lane :upload_appstore_build do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APPLE_API_KEY_ID"),
      issuer_id: ENV.fetch("APPLE_API_ISSUER_ID"),
      key_content: ENV.fetch("APPLE_API_PRIVATE_KEY"),
      is_key_content_base64: false,
      duration: 1200,
      in_house: false
    )

    upload_to_app_store(
      api_key: api_key,
      ipa: ENV.fetch("APPLE_IPA_PATH"),
      app_identifier: ENV.fetch("APPLE_BUNDLE_ID", "org.snapetech.plezyng"),
      platform: ENV.fetch("APPLE_STORE_PLATFORM", "ios"),
      force: true,
      skip_metadata: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      submit_for_review: false,
      automatic_release: false
    )
  end
end
