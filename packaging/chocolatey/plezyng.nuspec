<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>plezyng</id>
    <version>0.0.0</version>
    <title>PlezyNG</title>
    <authors>SnapeTech</authors>
    <owners>SnapeTech</owners>
    <licenseUrl>https://github.com/snapetech-org/PlezyNG/blob/main/LICENSE</licenseUrl>
    <projectUrl>https://github.com/snapetech-org/PlezyNG</projectUrl>
    <packageSourceUrl>https://github.com/snapetech-org/PlezyNG/tree/main/packaging/chocolatey</packageSourceUrl>
    <bugTrackerUrl>https://github.com/snapetech-org/PlezyNG/issues</bugTrackerUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>PlezyNG is an enhanced Plex client that also supports Jellyfin and Emby. Browse movies, shows, and music across your servers, search connected libraries, and keep watchlists and viewing progress in sync. Download media for offline playback. Watch Live TV and DVR where your server supports them. Choose audio tracks and subtitles, adjust playback speed and audio sync, and use HDR or Dolby Vision on supported devices. Watch Together keeps playback in sync when everyone can access the same media on the same server. Use PlezyNG on phones, tablets, TVs, and desktop computers. You’ll need your own Plex, Jellyfin, or Emby server. Features vary by server, device, and media.</description>
    <summary>Plex client with Jellyfin and Emby support, offline downloads, and HDR</summary>
    <tags>plezyng media plex jellyfin emby</tags>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
