<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Store export of the iOS and tvOS archives (scripts/release/deploy.py's ios and tvos phases): an IPA
	     signed for App Store Connect in build/deploy/apple/export-<platform>, which xcrun altool then uploads. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>export</string>
	<key>teamID</key>
	<string>G88U5B5783</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<!-- The archive's CFBundleVersion is version.xcconfig's CURRENT_PROJECT_VERSION, which the release names. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
