# Copy outside the source tree and supply paths/flags from your Samsung SDK.
# No desktop compiler fallback: these values are deliberately mandatory.
set(CMAKE_SYSTEM_NAME Linux)
foreach(input TIZEN_C_COMPILER TIZEN_CXX_COMPILER TIZEN_SYSROOT TIZEN_PROCESSOR TIZEN_ABI_FLAGS)
  if("$ENV{${input}}" STREQUAL "")
    message(FATAL_ERROR "Set ${input} from the provisioned Samsung TV toolchain")
  endif()
endforeach()
set(CMAKE_SYSTEM_PROCESSOR "$ENV{TIZEN_PROCESSOR}")
set(CMAKE_C_COMPILER "$ENV{TIZEN_C_COMPILER}")
set(CMAKE_CXX_COMPILER "$ENV{TIZEN_CXX_COMPILER}")
set(CMAKE_SYSROOT "$ENV{TIZEN_SYSROOT}")
set(CMAKE_C_FLAGS_INIT "$ENV{TIZEN_ABI_FLAGS} -fPIC")
set(CMAKE_CXX_FLAGS_INIT "$ENV{TIZEN_ABI_FLAGS} -fPIC")
set(CMAKE_FIND_ROOT_PATH "$ENV{TIZEN_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
