diff --git a/src/ihs_clock.h b/src/ihs_clock.h
new file mode 100644
--- /dev/null
+++ b/src/ihs_clock.h
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+#pragma once
+#include <stdint.h>
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+// QPC is monotonic and independent of wall-clock adjustments. Split the integer
+// division before scaling so the counter does not overflow after long uptimes.
+static inline uint64_t IHS_MonotonicNanos(void) {
+    LARGE_INTEGER ticks, frequency;
+    QueryPerformanceCounter(&ticks);
+    QueryPerformanceFrequency(&frequency);
+    uint64_t value = (uint64_t) ticks.QuadPart, rate = (uint64_t) frequency.QuadPart;
+    return (value / rate) * 1000000000ull + (uint64_t) ((double) (value % rate) * 1000000000.0 / (double) rate);
+}
+static inline void IHS_SleepMicros(uint32_t micros) {
+    Sleep((DWORD) (((uint64_t) micros + 999) / 1000));
+}
+#else
+#include <time.h>
+#include <errno.h>
+static inline uint64_t IHS_MonotonicNanos(void) {
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    return (uint64_t) now.tv_sec * 1000000000ull + (uint64_t) now.tv_nsec;
+}
+static inline void IHS_SleepMicros(uint32_t micros) {
+    struct timespec delay = {micros / 1000000, (micros % 1000000) * 1000};
+    while (nanosleep(&delay, &delay) != 0 && errno == EINTR) {}
+}
+#endif
