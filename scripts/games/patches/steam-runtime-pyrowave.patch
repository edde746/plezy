 }
+static void negotiation_pyrowave(void) {
+    IHS_Session *s = session_new();
+    s->state.connectionState = IHS_SessionConnectionStateNegotiating;
+    IHS_SessionConfig requested = {.enableAudio = true, .enableHevc = true, .enablePyrowave = true,
+        .maxWidth = 1280, .maxHeight = 720, .maxFps = 60, .maxBitrateKbps = 30000};
+    IHS_StreamSessionCallbacks callbacks = {.configuring = configure_quality};
+    s->callbacks.session = &callbacks;
+    s->callbackContexts.session = &requested;
+    CNegotiationInitMsg message = CNEGOTIATION_INIT_MSG__INIT;
+    EStreamVideoCodec offered[] = {k_EStreamVideoCodecH264, k_EStreamVideoCodecHEVC,
+                                   k_EStreamVideoCodecPyrowave};
+    message.n_supported_video_codecs = sizeof(offered) / sizeof(offered[0]);
+    message.supported_video_codecs = offered;
+    IHS_Buffer body = IHS_BUFFER_INIT(1024, 1024);
+    IHS_BufferAppendMessage(&body, (ProtobufCMessage *)&message);
+    IHS_SessionPacketHeader header = {0};
+    IHS_SessionChannelControlOnNegotiation(s->channels[1], k_EStreamControlNegotiationInit, &body, &header);
+    IHS_QueueItem *q = IHS_QueuePoll(s->sendQueue);
+    assert(q);
+    IHS_BufferOffsetBy(&q->packet.body, 1);
+    IHS_Buffer plain = IHS_BUFFER_INIT(2048, 2048);
+    uint64_t sequence;
+    assert(IHS_SessionFrameDecrypt(s, &q->packet.body, &plain, 0, &sequence) == 0);
+    CNegotiationSetConfigMsg *config = cnegotiation_set_config_msg__unpack(NULL, plain.size, IHS_BufferPointer(&plain));
+    assert(config && config->config && config->streaming_client_config && config->streaming_client_caps);
+    assert(config->config->selected_video_codec == k_EStreamVideoCodecPyrowave);
+    assert(config->streaming_client_config->enable_video_pyrowave);
+    assert(config->streaming_client_caps->n_supported_video_codecs == 3);
+    assert(config->streaming_client_caps->supported_video_codecs[0] == k_EStreamVideoCodecPyrowave);
+    assert(config->streaming_client_caps->supported_video_codecs[1] == k_EStreamVideoCodecHEVC);
+    assert(config->streaming_client_caps->supported_video_codecs[2] == k_EStreamVideoCodecH264);
+    cnegotiation_set_config_msg__free_unpacked(config, NULL);
+    IHS_BufferClear(&plain, true);
+    IHS_BufferClear(&body, true);
+    IHS_SessionPacketClear(&q->packet, true);
+    IHS_QueueItemFree(q);
+    IHS_SessionDestroy(s);
+}
+static void negotiation_pyrowave_unavailable(void) {
+    IHS_Session *s = session_new();
+    s->state.connectionState = IHS_SessionConnectionStateNegotiating;
+    IHS_SessionConfig requested = {.enableAudio = true, .enableHevc = true, .enablePyrowave = true,
+        .maxWidth = 1280, .maxHeight = 720, .maxFps = 60, .maxBitrateKbps = 30000};
+    IHS_StreamSessionCallbacks callbacks = {.configuring = configure_quality};
+    s->callbacks.session = &callbacks;
+    s->callbackContexts.session = &requested;
+    CNegotiationInitMsg message = CNEGOTIATION_INIT_MSG__INIT;
+    EStreamVideoCodec offered[] = {k_EStreamVideoCodecH264, k_EStreamVideoCodecHEVC};
+    message.n_supported_video_codecs = sizeof(offered) / sizeof(offered[0]);
+    message.supported_video_codecs = offered;
+    IHS_Buffer body = IHS_BUFFER_INIT(1024, 1024);
+    IHS_BufferAppendMessage(&body, (ProtobufCMessage *)&message);
+    IHS_SessionPacketHeader header = {0};
+    IHS_SessionChannelControlOnNegotiation(s->channels[1], k_EStreamControlNegotiationInit, &body, &header);
+    IHS_QueueItem *q = IHS_QueuePoll(s->sendQueue);
+    assert(q);
+    IHS_BufferOffsetBy(&q->packet.body, 1);
+    IHS_Buffer plain = IHS_BUFFER_INIT(2048, 2048);
+    uint64_t sequence;
+    assert(IHS_SessionFrameDecrypt(s, &q->packet.body, &plain, 0, &sequence) == 0);
+    CNegotiationSetConfigMsg *config = cnegotiation_set_config_msg__unpack(NULL, plain.size, IHS_BufferPointer(&plain));
+    assert(config && config->config && config->streaming_client_config);
+    assert(config->config->selected_video_codec == k_EStreamVideoCodecHEVC);
+    assert(!config->streaming_client_config->enable_video_pyrowave);
+    cnegotiation_set_config_msg__free_unpacked(config, NULL);
+    IHS_BufferClear(&plain, true);
+    IHS_BufferClear(&body, true);
+    IHS_SessionPacketClear(&q->packet, true);
+    IHS_QueueItemFree(q);
+    IHS_SessionDestroy(s);
+}
