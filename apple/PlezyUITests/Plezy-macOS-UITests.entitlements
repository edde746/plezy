<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
The macOS UI tests' runner, which Xcode signs with these merged into its own sandbox entitlements (network client
only): it may listen too, on 127.0.0.1, for the proxy in front of the test server (ServerProxy,
PlezyUITests/Shared/ServerProxy.swift), and it may change the Debug app's data folder (DataResetTests' database). The
iOS and tvOS simulators' runners aren't sandboxed.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
	<array>
		<string>/Library/Application Support/com.edde746.plezy.dev/</string>
	</array>
</dict>
</plist>
