-- SecretStore keys no connection or profile binding names: the tokens of a change not yet committed, and those a
-- committed change replaced or removed. Each key is listed in the transaction that stops a row naming it (before it's
-- written, for a new one) and leaves the list once it's gone from the SecretStore; the start deletes those an
-- interrupted change left (data/connections/IdentitySecrets).
CREATE TABLE unreferenced_secrets (
    secret_key TEXT NOT NULL PRIMARY KEY
);

insertKey:
INSERT OR IGNORE INTO unreferenced_secrets VALUES (?);

deleteKey:
DELETE FROM unreferenced_secrets WHERE secret_key = ?;

selectAll:
SELECT secret_key FROM unreferenced_secrets;
