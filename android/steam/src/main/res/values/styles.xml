<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PlezySteamTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/plezy_steam_background</item>
        <item name="android:colorBackground">@color/plezy_steam_background</item>
        <item name="android:colorAccent">@color/plezy_steam_focus</item>
        <item name="android:colorControlActivated">@color/plezy_steam_focus</item>
        <item name="android:colorControlHighlight">@color/plezy_steam_outline</item>
        <item name="android:colorButtonNormal">@color/plezy_steam_surface</item>
        <item name="android:textColorPrimary">@color/plezy_steam_text</item>
        <item name="android:textColorSecondary">@color/plezy_steam_text_muted</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:alertDialogTheme">@style/PlezySteamDialog</item>
    </style>

    <style name="PlezySteamDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/plezy_steam_dialog_background</item>
        <item name="android:colorAccent">@color/plezy_steam_focus</item>
        <item name="android:colorControlHighlight">@color/plezy_steam_outline</item>
        <item name="android:textColorPrimary">@color/plezy_steam_text</item>
        <item name="android:textColorSecondary">@color/plezy_steam_text_muted</item>
        <item name="android:fontFamily">sans</item>
    </style>
</resources>
