<?xml version="1.0" encoding="utf-8"?>
<!-- installLocation auto lets the system move the app to adoptable storage (a USB drive an Android TV adopted, an adopted
     SD card), which moves its private data, the downloads with it. The app declares none of the components that is
     unsafe for (app widgets, input methods, live wallpapers, device admins, accessibility services, sync adapters,
     account authenticators). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto">

    <!-- The app runs from Android 7.1 (Fire OS 6, minSdk 25); the watch-together relay client (party.openwatch) declares
         26 but needs nothing above 25: its classes call no platform API newer than 25 (java.lang and java.util only; D8
         desugars its lambdas and string concatenation at minSdk 25), and it runs on the app's own Ktor, coroutines and
         serialization. -->
    <uses-sdk tools:overrideLibrary="party.openwatch" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The process follows the default network (ProcessNetwork): offline states, Wi-Fi only downloads. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The media session's service runs in the foreground while a playback plays (PlaybackService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Downloads run in a foreground dataSync worker (DownloadWorker) with a progress notification, asked for at the
         first download (Android 13+); the media notification is exempt and never asks. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android TV's Watch Next row (WatchNext): the TV provider takes this app's rows only with it on some boxes. -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <!-- The Watch Next posters' read grants don't survive a reboot: they are granted again at boot
         (WatchNextGrantReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The audio output's settings (passthrough, the audio focus of playback) and moving the app's task to the front. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <!-- No library brings storage or media permissions: downloads go to the app's folders or a folder the user picked
         through the system's picker. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />

    <!-- One APK for phones, tablets, Android TV, Fire TV and Android Automotive (whose car service tells driving from
         parked: CarRestrictionsMonitor, through the optional android.car library). -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />

    <!-- Package visibility (API 30+): whether a browser can open a link, and which player apps play
         video (AndroidPlayerApps: a stream at an http(s) URL, a download's content:// URI). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <!-- Every launcher, which reads the Watch Next posters through a read grant each (ShelfArtwork). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" android:mimeType="video/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:mimeType="video/*" />
        </intent>
        <!-- The text-selection menu's Process Text apps. -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <!-- Icons are generated by tools/brand/generate.sh; the TV banner (drawable-*dpi/banner.png) is committed as is. -->
    <application
        android:name=".PlezyApplication"
        android:banner="@drawable/banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:appCategory="video"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:largeHeap="true"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Plezy">
        <uses-library android:name="android.car" android:required="false" />
        <!-- One activity holds the whole app: configuration changes (rotation, folding, resizing, dark mode, entering and
             leaving picture-in-picture) don't recreate it, and a launch while it runs brings it back as it was.
             turnScreenOn lets a link that arrives during the screensaver wake the device; set at runtime it comes too
             late, as the activity is already launched behind the screensaver. singleTop: a link while the app is on top
             reaches the running activity (onNewIntent); no task affinity, so it never joins another app's task. The
             activity has no launcher entry of its own: the launcher's are the aliases below, one enabled at a time, so
             the app icon can change. Links stay here, so they open whichever alias is enabled. -->
        <activity
            android:name=".PlezyActivity"
            android:turnScreenOn="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|keyboardHidden|keyboard|navigation|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:windowSoftInputMode="adjustResize">
            <!-- Every plezy:// link, whatever its host (PlezyActivity hands it to the app). The test builds drop this
                 filter (src/debug/AndroidManifest.xml). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="plezy" />
            </intent-filter>
        </activity>
        <!-- The default icon's launcher entry. Its component name must never change: it has been the launcher's since the
             first release, so home-screen shortcuts, TV favourites and recent tasks point at it, and a device keeps each
             alias's enabled state across updates. -->
        <activity-alias
            android:name=".MainActivity"
            android:exported="true"
            android:targetActivity=".PlezyActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
