        <!-- Shows the playback's media notification, in the foreground while it plays. Media
             controllers reach the session through the system, not this service. -->
        <service
            android:name=".media.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- The media notification's actions and its dismissal (PlaybackNotification). -->
        <receiver
            android:name=".media.MediaActionReceiver"
            android:exported="false" />
        <!-- WorkManager's foreground service, which the download worker runs in: a data transfer (DownloadWorker). -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
        <!-- The download notification's Pause and Cancel actions (DownloadNotifications). -->
        <receiver
            android:name=".downloads.android.DownloadActionReceiver"
            android:exported="false" />
        <!-- A download's file and its saved subtitles, read-only for the player app they are handed to
             (AndroidPlayerApps). The release build's authority is com.edde746.plezy.fileprovider, as the earlier
             releases'; the test builds (com.edde746.plezy.dev) get their own, so both install side by side. -->
        <provider
            android:name=".players.PlayerFiles"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
        <!-- The home screen's word that the user removed one of this app's Watch Next rows (WatchNext). Sent by the
             system, so exported. -->
        <receiver
            android:name=".watchnext.WatchNextRemovedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.tv.action.WATCH_NEXT_PROGRAM_BROWSABLE_DISABLED" />
            </intent-filter>
        </receiver>
        <!-- The Watch Next posters the app downloaded (ShelfArtwork): not exported, read by the launchers only through
             a grant per poster. -->
        <provider
            android:name=".watchnext.ShelfArtworkProvider"
            android:authorities="${applicationId}.systemshelf.artwork"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- Grants the launchers the Watch Next posters again after a reboot or an update (WatchNext.grantAgain). -->
        <receiver
            android:name=".watchnext.WatchNextGrantReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Sentry starts only while crash reports are on (AndroidCrashReports), never by itself at launch: its two
             start-up providers go. -->
        <provider
            android:name="io.sentry.android.core.SentryInitProvider"
            android:authorities="${applicationId}.SentryInitProvider"
            tools:node="remove" />
        <provider
            android:name="io.sentry.android.core.SentryPerformanceProvider"
            android:authorities="${applicationId}.SentryPerformanceProvider"
            tools:node="remove" />
