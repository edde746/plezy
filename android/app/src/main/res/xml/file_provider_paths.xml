<?xml version="1.0" encoding="utf-8"?>
<!-- What the file provider (PlayerFiles) can name: a download's file and its saved subtitles wherever they are kept,
     shared with a player app one URI at a time. The roots and their names are the earlier releases', so URIs keep their
     shape. -->
<paths>
    <!-- Internal storage. -->
    <files-path name="app_files" path="." />
    <!-- The primary volume's app directory. -->
    <external-files-path name="external_files" path="." />
    <!-- Shared storage (custom download folders). -->
    <external-path name="external" path="." />
    <!-- The caches. -->
    <cache-path name="cache" path="." />
    <external-cache-path name="external_cache" path="." />
    <!-- Any other absolute path: other volumes, and internal folders beside files/ such as app_flutter/. -->
    <root-path name="root" path="" />
</paths>
