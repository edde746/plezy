<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. The secret store (shared secrets/AndroidSecretStore) is sealed under a Keystore key that never
     leaves this device, so a backed-up copy would be unreadable anywhere else: keep it out of backups. It is the only
     Keystore-sealed data. The earlier release's files stay out too: its database and the downloads under app_flutter,
     and both preference stores holding the key to its credentials (the datastore file and the shared preferences).
     Completed downloads would also push a backup past its size limit, and then nothing is backed up.
     Everything else goes, on purpose: the database (plezy.db, its -wal and -shm), addon links and the keys in them
     included, so a restored device has its addons back and signs in again. It holds no media server's token: those
     live in the secret store, and download tasks are kept without them (the downloader adds them to each request).
     Downloads in progress (noBackupFilesDir) and the caches never go. -->
<full-backup-content>
    <exclude domain="sharedpref" path="com.edde746.plezy.secrets.xml" />
    <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
    <exclude domain="file" path="datastore/FlutterSharedPreferences.preferences_pb" />
    <exclude domain="root" path="app_flutter/" />
</full-backup-content>
