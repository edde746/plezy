<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- User-entered hosts: a self-hosted Plex, Jellyfin or Emby server, or a self-hosted watch-together relay on the
         LAN, may be plain HTTP or behind a private CA the device owner installed. Their hosts aren't knowable at build
         time, so the base config trusts the user's CAs beside the system's. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Fixed endpoints carry account tokens, OAuth codes, crash reports and update metadata, are HTTPS only and never
         sit behind a private CA: system anchors only, no plain HTTP (a redirect to http:// fails). *.plex.direct (a
         user's server) is not plex.tv and keeps the base config. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">plex.tv</domain>
        <domain includeSubdomains="true">plezy.app</domain>
        <domain includeSubdomains="true">trakt.tv</domain>
        <domain includeSubdomains="true">myanimelist.net</domain>
        <domain includeSubdomains="true">anilist.co</domain>
        <domain includeSubdomains="true">simkl.com</domain>
        <domain includeSubdomains="true">mdblist.com</domain>
        <domain includeSubdomains="true">simkl.in</domain>
        <domain includeSubdomains="true">jsdelivr.net</domain>
        <domain includeSubdomains="true">github.com</domain>
        <!-- Where github.com redirects the anime mappings release asset download. -->
        <domain includeSubdomains="true">githubusercontent.com</domain>
        <domain includeSubdomains="true">image.tmdb.org</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
