<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into GitHub release builds only (selfUpdatingBuild in build.gradle.kts): lets
     AppUpdateChannel open the system installer for a downloaded update. Android still asks the
     user to allow Plezy to install apps, and to confirm each update. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
