<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Serves a test asset over content:// so instrumentation covers the
             SAF/ContentDataSource read path. Exported because the test body
             runs in the app's process while this provider lives in the
             androidTest APK's own uid; it serves nothing but this APK's own
             assets. Merged into the androidTest APK, never into the app. -->
        <provider
            android:name="com.edde746.plezy.exoplayer.FixtureContentProvider"
            android:authorities="com.edde746.plezy.test.fixtures"
            android:exported="true" />
    </application>

</manifest>
