	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>PlezyNG can use a camera as an optional source for a local recording.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>PlezyNG can include a selected microphone in a local recording.</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>PlezyNG connects to your media servers and playback devices on your local network.</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>FLTEnableMergedPlatformUIThread</key>
	<false/>
	<!-- Keep rendering with Skia. Flutter 3.47 made Impeller the default macOS
	     renderer, and PlezyNG is unusually exposed to that switch: the Flutter view
	     is cleared to transparent so mpv's video layer behind it stays visible,
	     so anything Impeller leaves in the presented drawable is composited
	     straight onto the screen instead of being covered. On the Metal SDF text
	     path that surfaced as glyphs filled with noise and whole glyph-atlas
	     textures flashing full screen whenever a keypress rasterized new glyphs
	     (#2132). Every release up to 2.17.0 rendered with Skia; keep it until the
	     engine fix that landed for flutter/flutter#191538 reaches stable. -->
	<key>FLTEnableImpeller</key>
	<false/>
	<key>SUEnableAutomaticChecks</key>
	<false/>
	<key>SUFeedURL</key>
	<string>https://cdn.jsdelivr.net/gh/snapetech-org/PlezyNG@appcast/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string></string>
</dict>
