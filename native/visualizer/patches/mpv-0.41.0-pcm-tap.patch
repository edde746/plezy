+int mpv_plezy_audio_tap_version(void) { return MPV_PLEZY_AUDIO_TAP_ABI; }
+
+int mpv_plezy_audio_tap_enable(mpv_handle *ctx, int enabled)
+{
+    if (!ctx) return MPV_ERROR_INVALID_PARAMETER;
+    int result = 0;
+    lock_core(ctx);
+    mp_mutex_lock(&ctx->lock);
+    if (enabled) {
+        if (ctx->mpctx->visualizer_audio_tap &&
+            ctx->mpctx->visualizer_audio_tap != ctx->audio_tap) {
+            result = MPV_ERROR_PROPERTY_UNAVAILABLE;
+        } else if (!ctx->audio_tap) {
+            ctx->audio_tap = mp_plezy_audio_tap_new();
+            if (!ctx->audio_tap) result = MPV_ERROR_NOMEM;
+            else ctx->mpctx->visualizer_audio_tap = ctx->audio_tap;
+        }
+    } else if (ctx->audio_tap) {
+        ctx->mpctx->visualizer_audio_tap = NULL;
+        mp_plezy_audio_tap_free(ctx->audio_tap);
+        ctx->audio_tap = NULL;
+    }
+    mp_mutex_unlock(&ctx->lock);
+    unlock_core(ctx);
+    return result;
+}
+
+int mpv_plezy_audio_tap_read(mpv_handle *ctx, double pts,
+                           mpv_plezy_audio_block *out, size_t size)
+{
+    if (!ctx || !out || size != sizeof(*out)) return MPV_ERROR_INVALID_PARAMETER;
+    mp_mutex_lock(&ctx->lock);
+    int result = mp_plezy_audio_tap_read(ctx->audio_tap, pts, out);
+    mp_mutex_unlock(&ctx->lock);
+    return result;
+}
+
 void mpv_wait_async_requests(mpv_handle *ctx)
 {
     mp_mutex_lock(&ctx->lock);
@@ -426,6 +465,8 @@ static void mp_destroy_client(mpv_handle *ctx, bool terminate)
