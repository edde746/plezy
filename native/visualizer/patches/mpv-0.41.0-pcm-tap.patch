diff --git a/player/plezy_audio_tap.c b/player/plezy_audio_tap.c
new file mode 100644
index 0000000..8d34c84
--- /dev/null
+++ b/player/plezy_audio_tap.c
@@ -0,0 +1,149 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * Read-only, bounded SPSC analysis transport. The playback thread only copies
+ * samples; it never waits, allocates, invokes application code or calls Dart.
+ */
+#include <math.h>
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <string.h>
+#include "audio/aframe.h"
+#include "audio/chmap.h"
+#include "audio/format.h"
+#include "common/common.h"
+#include "plezy_audio_tap.h"
+
+#define TAP_SLOTS 32u
+#define TAP_SUBMIT_LIMIT (MPV_PLEZY_AUDIO_TAP_FRAMES * 8)
+struct mp_plezy_audio_tap {
+    atomic_uint read_index, write_index, generation, dropped_frames;
+    atomic_int status;
+    int rate, format, channels;
+    uint8_t speakers[MPV_PLEZY_AUDIO_TAP_CHANNELS];
+    mpv_plezy_audio_block slots[TAP_SLOTS];
+};
+
+struct mp_plezy_audio_tap *mp_plezy_audio_tap_new(void)
+{
+    struct mp_plezy_audio_tap *tap = calloc(1, sizeof(*tap));
+    if (!tap) return NULL;
+    atomic_init(&tap->read_index, 0);
+    atomic_init(&tap->write_index, 0);
+    atomic_init(&tap->generation, 1);
+    atomic_init(&tap->dropped_frames, 0);
+    atomic_init(&tap->status, 0);
+    if (!atomic_is_lock_free(&tap->read_index) ||
+        !atomic_is_lock_free(&tap->status)) {
+        free(tap);
+        return NULL;
+    }
+    return tap;
+}
+
+void mp_plezy_audio_tap_free(struct mp_plezy_audio_tap *tap) { free(tap); }
+
+void mp_plezy_audio_tap_reset(struct mp_plezy_audio_tap *tap)
+{
+    if (!tap) return;
+    atomic_fetch_add_explicit(&tap->generation, 1, memory_order_release);
+    atomic_store_explicit(&tap->status, 0, memory_order_release);
+}
+
+static float sample_at(const uint8_t *data, int format)
+{
+    // memcpy avoids alignment and strict-aliasing assumptions about AVFrame.
+    double result = 0;
+    switch (format) {
+    case AF_FORMAT_U8: result = ((int)*data - 128) / 128.0; break;
+    case AF_FORMAT_S16: { int16_t x; memcpy(&x, data, sizeof x); result = x / 32768.0; break; }
+    case AF_FORMAT_S32: { int32_t x; memcpy(&x, data, sizeof x); result = x / 2147483648.0; break; }
+    case AF_FORMAT_S64: { int64_t x; memcpy(&x, data, sizeof x); result = x / 9223372036854775808.0; break; }
+    case AF_FORMAT_FLOAT: { float x; memcpy(&x, data, sizeof x); result = x; break; }
+    case AF_FORMAT_DOUBLE: { double x; memcpy(&x, data, sizeof x); result = x; break; }
+    }
+    return isfinite(result) ? fmax(-1.0, fmin(1.0, result)) : 0;
+}
+
+void mp_plezy_audio_tap_submit(struct mp_plezy_audio_tap *tap,
+                             struct mp_aframe *frame, double speed)
+{
+    if (!tap) return;
+    int format = mp_aframe_get_format(frame);
+    int rate = mp_aframe_get_rate(frame);
+    int scalar_format = af_fmt_from_planar(format);
+    struct mp_chmap map = {0};
+    mp_aframe_get_chmap(frame, &map);
+    uint8_t **data = mp_aframe_get_data_ro(frame);
+    if (scalar_format < AF_FORMAT_U8 || scalar_format > AF_FORMAT_DOUBLE ||
+        !af_fmt_is_pcm(format) || rate <= 0 || map.num < 1 ||
+        map.num > MPV_PLEZY_AUDIO_TAP_CHANNELS || !data ||
+        !isfinite(speed) || speed <= 0) {
+        if (atomic_exchange_explicit(&tap->status, MPV_PLEZY_AUDIO_UNSUPPORTED, memory_order_acq_rel) != MPV_PLEZY_AUDIO_UNSUPPORTED)
+            atomic_fetch_add_explicit(&tap->generation, 1, memory_order_release);
+        return;
+    }
+    if (tap->rate != rate || tap->format != format || tap->channels != map.num ||
+        memcmp(tap->speakers, map.speaker, map.num)) {
+        mp_plezy_audio_tap_reset(tap);
+        tap->rate = rate; tap->format = format; tap->channels = map.num;
+        memcpy(tap->speakers, map.speaker, map.num);
+    }
+    atomic_store_explicit(&tap->status, 1, memory_order_release);
+    int total = mp_aframe_get_size(frame);
+    int limit = MPMIN(total, TAP_SUBMIT_LIMIT);
+    int bytes = af_fmt_to_bytes(format);
+    bool planar = af_fmt_is_planar(format);
+    unsigned int generation = atomic_load_explicit(&tap->generation, memory_order_acquire);
+    double pts = mp_aframe_get_pts(frame);
+    int offset = 0;
+    for (; offset < limit;) {
+        unsigned int write = atomic_load_explicit(&tap->write_index, memory_order_relaxed);
+        unsigned int read = atomic_load_explicit(&tap->read_index, memory_order_acquire);
+        if (write - read >= TAP_SLOTS) break; // Drop analysis; never delay audio.
+        mpv_plezy_audio_block *block = &tap->slots[write % TAP_SLOTS];
+        int count = MPMIN(limit - offset, MPV_PLEZY_AUDIO_TAP_FRAMES);
+        block->generation = generation;
+        block->frames = count;
+        block->sample_rate = rate;
+        block->channels = map.num;
+        block->dropped_frames = atomic_load_explicit(&tap->dropped_frames, memory_order_relaxed);
+        memset(block->speaker_ids, 0, sizeof block->speaker_ids);
+        memcpy(block->speaker_ids, map.speaker, map.num);
+        block->seconds_per_frame = speed / rate;
+        block->pts = pts == MP_NOPTS_VALUE ? pts : pts + offset * block->seconds_per_frame;
+        for (int n = 0; n < count; n++) {
+            for (int ch = 0; ch < map.num; ch++) {
+                size_t index = planar ? offset + n : (offset + n) * map.num + ch;
+                block->samples[n * map.num + ch] = sample_at(
+                    data[planar ? ch : 0] + index * bytes, scalar_format);
+            }
+        }
+        atomic_store_explicit(&tap->write_index, write + 1, memory_order_release);
+        offset += count;
+    }
+    if (total > offset)
+        atomic_fetch_add_explicit(&tap->dropped_frames, total - offset, memory_order_relaxed);
+}
+
+int mp_plezy_audio_tap_read(struct mp_plezy_audio_tap *tap, double pts,
+                          mpv_plezy_audio_block *out)
+{
+    if (!tap || !isfinite(pts) || pts == MP_NOPTS_VALUE) return 0;
+    int status = atomic_load_explicit(&tap->status, memory_order_acquire);
+    if (status <= 0) return status;
+    for (unsigned int n = 0; n < TAP_SLOTS; n++) {
+        unsigned int read = atomic_load_explicit(&tap->read_index, memory_order_relaxed);
+        unsigned int write = atomic_load_explicit(&tap->write_index, memory_order_acquire);
+        if (read == write) return 0;
+        const mpv_plezy_audio_block *block = &tap->slots[read % TAP_SLOTS];
+        unsigned int generation = atomic_load_explicit(&tap->generation, memory_order_acquire);
+        bool valid = block->generation == generation && isfinite(block->pts) &&
+                     block->pts != MP_NOPTS_VALUE &&
+                     block->pts + block->frames * block->seconds_per_frame >= pts - 0.10;
+        if (valid && block->pts > pts) return 0; // Keep future audio queued.
+        if (valid) memcpy(out, block, sizeof(*out));
+        atomic_store_explicit(&tap->read_index, read + 1, memory_order_release);
+        if (valid && generation == atomic_load_explicit(&tap->generation, memory_order_acquire))
+            return 1;
+    }
+    return 0;
+}
