--- a/player/client.c
+++ b/player/client.c
@@ -46,6 +46,7 @@
 #include "command.h"
 #include "core.h"
 #include "client.h"
+#include "plezy_audio_tap.h"
 
 /*
  * Locking hierarchy:
@@ -117,6 +118,7 @@ struct mpv_handle {
     struct observe_property *cur_property;
 
     mp_mutex lock;
+    struct mp_plezy_audio_tap *audio_tap; // protected by lock; owned by this handle
 
     mp_mutex wakeup_lock;
     mp_cond wakeup;
@@ -389,6 +391,43 @@ static void unlock_core(mpv_handle *ctx)
     mp_dispatch_unlock(ctx->mpctx->dispatch);
