{
  "app-id": "com.edde746.plezy",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "plezy",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--device=all",
    "--own-name=org.mpris.MediaPlayer2.com_edde746_plezy",
    "--system-talk-name=org.freedesktop.NetworkManager",
    "--filesystem=xdg-run/os_media_controls_artwork:create",
    "--filesystem=xdg-run/discord-ipc-0",
    "--filesystem=xdg-run/discord-ipc-1",
    "--filesystem=xdg-run/discord-ipc-2",
    "--filesystem=xdg-run/discord-ipc-3",
    "--filesystem=xdg-run/discord-ipc-4",
    "--filesystem=xdg-run/discord-ipc-5",
    "--filesystem=xdg-run/discord-ipc-6",
    "--filesystem=xdg-run/discord-ipc-7",
    "--filesystem=xdg-run/discord-ipc-8",
    "--filesystem=xdg-run/discord-ipc-9",
    "--filesystem=xdg-run/app/com.discordapp.Discord:ro",
    "--env=GTK_USE_PORTAL=1"
  ],
  "build-options": {
    "strip": false,
    "no-debuginfo": true
  },
  "modules": [
    {
      "name": "plezy",
      "buildsystem": "simple",
      "build-commands": [
        "cp -a bundle /app/plezy",
        "install -Dm755 plezy /app/bin/plezy",
        "install -Dm644 com.edde746.plezy.desktop /app/share/applications/com.edde746.plezy.desktop",
        "install -Dm644 com.edde746.plezy.metainfo.xml /app/share/metainfo/com.edde746.plezy.metainfo.xml",
        "install -Dm644 plezy.png /app/share/icons/hicolor/512x512/apps/com.edde746.plezy.png",
        "chmod 755 /app/plezy/plezy.sh",
        "if test -f /app/plezy/lib/crashpad_handler; then chmod 755 /app/plezy/lib/crashpad_handler; fi",
        "python3 relocate-caches.py /app/plezy"
      ],
      "sources": [
        { "type": "dir", "path": "bundle", "dest": "bundle" },
        { "type": "file", "path": "plezy" },
        { "type": "file", "path": "relocate-caches.py" },
        { "type": "file", "path": "com.edde746.plezy.desktop" },
        { "type": "file", "path": "com.edde746.plezy.metainfo.xml" },
        { "type": "file", "path": "plezy.png" }
      ]
    }
  ]
}
